---
import profile from "../data/profile.json";
---

<section id="about" class="py-20 border-b border-slate-800/60 bg-slate-950/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Textual Narrative -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold tracking-wider text-emerald-400 uppercase">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Profilo & Approccio Operativo
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold text-slate-100 font-sans tracking-tight">
          Risposta tempestiva alle minacce con rigore scientifico e automazione.
        </h2>

        <div class="space-y-4 text-slate-300 text-base leading-relaxed">
          {profile.about.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <!-- Pillar highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-mono font-bold text-xs mb-3">
              01
            </div>
            <h3 class="text-sm font-semibold text-slate-200 mb-1">Incident Triage & Containment</h3>
            <p class="text-xs text-slate-400">Isolamento rapido e contenimento chirurgico per minimizzare il blast radius su asset critici.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-mono font-bold text-xs mb-3">
              02
            </div>
            <h3 class="text-sm font-semibold text-slate-200 mb-1">Deep Forensic Discovery</h3>
            <p class="text-xs text-slate-400">Acquisizione RAM, timeline log Hayabusa/Thor e correlazione evidenze host/network.</p>
          </div>

          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-mono font-bold text-xs mb-3">
              03
            </div>
            <h3 class="text-sm font-semibold text-slate-200 mb-1">Malware Deconstruction</h3>
            <p class="text-xs text-slate-400">Dissezionamento di payload malevoli, estrazione IoC e configurazioni C2 per la CTI.</p>
          </div>
        </div>
      </div>

      <!-- High-Tech Quick Specs Card -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 p-6 sm:p-8 shadow-2xl relative">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="font-mono text-xs text-slate-400">operator_id: MD-DFIR-01</span>
          </div>

          <div class="space-y-4 font-mono text-xs text-slate-300">
            <div>
              <span class="text-slate-500">OPERATORE:</span>
              <span class="text-emerald-400 font-semibold ml-2">Michele Dilollo</span>
            </div>
            <div>
              <span class="text-slate-500">RUOLO ATTUALE:</span>
              <span class="text-slate-200 ml-2">Incident Responder & DFIR Specialist (Telsy S.p.A.)</span>
            </div>
            <div>
              <span class="text-slate-500">LOCATION:</span>
              <span class="text-slate-200 ml-2">Roma, Italia</span>
            </div>
            <div>
              <span class="text-slate-500">SETTORI DI APPLICAZIONE:</span>
              <span class="text-slate-200 ml-2">Infrastrutture Critiche, Enterprise, Governativo</span>
            </div>
            <div>
              <span class="text-slate-500">SPECIALIZZAZIONI CORE:</span>
              <div class="mt-2 flex flex-wrap gap-1.5 font-sans">
                <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 text-[11px] font-mono border border-emerald-500/30">Memory Forensics</span>
                <span class="px-2 py-0.5 rounded bg-cyan-500/15 text-cyan-300 text-[11px] font-mono border border-cyan-500/30">Threat Hunting</span>
                <span class="px-2 py-0.5 rounded bg-indigo-500/15 text-indigo-300 text-[11px] font-mono border border-indigo-500/30">Malware Analysis</span>
                <span class="px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 text-[11px] font-mono border border-amber-500/30">Ransomware Detection</span>
                <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-[11px] font-mono border border-slate-700">Python Automation</span>
              </div>
            </div>
            <div class="pt-3 border-t border-slate-800/80">
              <span class="text-slate-500">CANALI ACCESSO:</span>
              <div class="mt-2 space-y-1">
                <div class="text-slate-300 flex items-center justify-between">
                  <span>Mail:</span>
                  <a href="mailto:michele.dlsr@gmail.com" class="text-emerald-400 hover:underline">michele.dlsr@gmail.com</a>
                </div>
                <div class="text-slate-300 flex items-center justify-between">
                  <span>Tel:</span>
                  <a href="tel:+393464931516" class="text-slate-300 hover:text-emerald-400">+39 346 49 31 516</a>
                </div>
                <div class="text-slate-300 flex items-center justify-between">
                  <span>GitHub:</span>
                  <a href="https://github.com/isf3t" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline">github.com/isf3t</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
