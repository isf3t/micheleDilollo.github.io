---
import profile from "../data/profile.json";
---

<section id="contact" class="py-20 bg-slate-950/60 border-b border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold tracking-wider text-emerald-400 uppercase mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Contatti & Canali di Comunicazione
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-100 font-sans tracking-tight mb-4">
        Iniziamo una Conversazione Operativa
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        Disponibile per opportunità professionali in ambito Incident Response, Threat Hunting, consulenze forensi avanzate e progetti ad alto impatto.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <!-- Email Card -->
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 flex flex-col justify-between group hover:border-emerald-500/40 transition-all">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="text-xs font-mono text-slate-500 uppercase mb-1">Email Diretta</div>
          <div class="text-sm font-semibold text-slate-200 font-mono break-all">
            {profile.email}
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <a
            href={`mailto:${profile.email}?subject=%5BDFIR%20Inquiry%5D%20Richiesta%20Contatto`}
            class="text-xs font-mono text-emerald-400 hover:underline flex items-center gap-1"
          >
            Invia Email ↗
          </a>
          <button
            type="button"
            id="copy-email-btn"
            data-email={profile.email}
            class="text-[11px] font-mono text-slate-400 hover:text-slate-200"
            aria-label="Copia indirizzo email"
          >
            Copia
          </button>
        </div>
      </div>

      <!-- Phone Card -->
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 flex flex-col justify-between group hover:border-emerald-500/40 transition-all">
        <div>
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div class="text-xs font-mono text-slate-500 uppercase mb-1">Telefono / Reperibilità</div>
          <div class="text-sm font-semibold text-slate-200 font-mono">
            {profile.phone}
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800/80">
          <a
            href={`tel:${profile.phone.replace(/\s+/g, '')}`}
            class="text-xs font-mono text-cyan-400 hover:underline flex items-center gap-1"
          >
            Chiama ↗
          </a>
        </div>
      </div>

      <!-- GitHub Profile Card -->
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 flex flex-col justify-between group hover:border-emerald-500/40 transition-all">
        <div>
          <div class="w-10 h-10 rounded-xl bg-slate-800 text-slate-200 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </div>
          <div class="text-xs font-mono text-slate-500 uppercase mb-1">GitHub Repositories</div>
          <div class="text-sm font-semibold text-slate-200 font-mono">
            @isf3t
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800/80">
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-slate-300 hover:text-emerald-400 flex items-center gap-1"
          >
            Esplora Codice ↗
          </a>
        </div>
      </div>

      <!-- LinkedIn Card -->
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 flex flex-col justify-between group hover:border-emerald-500/40 transition-all">
        <div>
          <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </div>
          <div class="text-xs font-mono text-slate-500 uppercase mb-1">Network Professionale</div>
          <div class="text-sm font-semibold text-slate-200 font-mono">
            Michele Dilollo
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-800/80">
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-sky-400 hover:underline flex items-center gap-1"
          >
            Connettiti ↗
          </a>
        </div>
      </div>
    </div>

    <!-- ATS CV Banner -->
    <div class="p-8 rounded-2xl bg-gradient-to-r from-slate-900 via-slate-900 to-emerald-950/40 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <h3 class="text-lg font-bold text-slate-100 font-sans">
          Hai bisogno di una copia completa del curriculum vitae?
        </h3>
        <p class="text-sm text-slate-400">
          Scarica la versione PDF standardizzata e ATS-ready con l'elenco integrale delle competenze, pubblicazioni e metriche di impatto.
        </p>
      </div>
      <a
        href="/cv.pdf"
        download="Michele_Dilollo_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold font-mono text-sm whitespace-nowrap shadow-lg shadow-emerald-500/10 transition-all"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Scarica CV in PDF (138 KB)
      </a>
    </div>
  </div>
</section>

<script is:inline>
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const email = copyBtn.getAttribute('data-email');
      if (email) {
        navigator.clipboard.writeText(email).then(() => {
          copyBtn.textContent = 'Copiato!';
          setTimeout(() => {
            copyBtn.textContent = 'Copia';
          }, 2000);
        });
      }
    });
  }
</script>
