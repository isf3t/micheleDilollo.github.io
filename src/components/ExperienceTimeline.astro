---
import experiences from "../data/experiences.json";
---

<section id="experience" class="py-20 border-b border-slate-800/60 bg-slate-950/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold tracking-wider text-emerald-400 uppercase mb-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        Percorso Professionale
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-100 font-sans tracking-tight mb-4">
        Esperienze sul Campo: Dai Sistemi Critici allo Sviluppo Software
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        Tracciamento cronologico degli incarichi operativi di Incident Response, attività accademica di docenza e ingegnerizzazione applicativa.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative border-l-2 border-slate-800 ml-3 sm:ml-6 space-y-12">
      {experiences.map((exp) => (
        <div class="relative pl-6 sm:pl-10 group">
          <!-- Timeline Node Marker -->
          <div class={`absolute -left-[9px] top-1.5 w-4 h-4 rounded-full border-2 transition-all ${
            exp.featured
              ? 'bg-emerald-500 border-slate-950 ring-4 ring-emerald-500/20'
              : 'bg-slate-800 border-slate-950 group-hover:bg-cyan-500 group-hover:ring-4 group-hover:ring-cyan-500/20'
          }`}></div>

          <!-- Experience Card -->
          <div class={`p-6 sm:p-8 rounded-2xl border transition-all ${
            exp.featured
              ? 'bg-gradient-to-b from-slate-900/90 to-slate-900/50 border-emerald-500/40 shadow-xl shadow-emerald-500/5'
              : 'bg-slate-900/40 border-slate-800/80 hover:border-slate-700'
          }`}>
            <!-- Top Metadata Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4 pb-4 border-b border-slate-800/80">
              <div>
                <div class="flex items-center gap-3 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold text-slate-100 font-sans">
                    {exp.role}
                  </h3>
                  {exp.featured && (
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                      Ruolo Attuale
                    </span>
                  )}
                </div>
                <div class="text-base font-medium text-emerald-400 font-mono mt-1">
                  {exp.company}
                </div>
              </div>

              <div class="flex flex-col sm:items-end text-xs font-mono text-slate-400">
                <span class="font-semibold text-slate-300">{exp.period}</span>
                <span>{exp.location} • {exp.type}</span>
              </div>
            </div>

            <!-- Detailed Highlights / Pillars -->
            <div class="space-y-4 mb-6">
              {exp.highlights.map((h) => (
                <div class="text-sm text-slate-300 leading-relaxed">
                  <div class="font-semibold text-slate-200 font-mono text-xs flex items-center gap-2 mb-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                    {h.area}
                  </div>
                  <p class="pl-3.5 text-slate-400">
                    {h.description}
                  </p>
                </div>
              ))}
            </div>

            <!-- Tags / Skills Applied -->
            <div class="pt-4 border-t border-slate-800/60 flex flex-wrap gap-2">
              {exp.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md bg-slate-800/60 text-slate-300 font-mono text-xs border border-slate-700/60">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
