---
import profile from "../data/profile.json";
---

<section id="hero" class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden border-b border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-medium mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        {profile.availability}
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-100 font-sans leading-[1.1] mb-6">
        <span class="block">{profile.name}</span>
        <span class="block text-2xl sm:text-4xl font-mono font-bold bg-gradient-to-r from-emerald-400 via-cyan-400 to-indigo-400 bg-clip-text text-transparent mt-2">
          {profile.specialization}
        </span>
      </h1>

      <!-- Executive Positioning Statement -->
      <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-3xl mb-8">
        Incident Responder specializzato nella difesa di infrastrutture critiche ed enterprise governative. Unisco una profonda padronanza dell'analisi forense avanzata (<span class="text-emerald-300 font-medium">Host, RAM con Volatility, Network</span>) e del <span class="text-cyan-300 font-medium">reverse engineering di malware</span> a un solido background ingegneristico per l'automazione della detection e della Threat Intelligence (CTI).
      </p>

      <!-- Key Value CTA Group -->
      <div class="flex flex-wrap items-center gap-4 mb-14">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold font-mono text-sm shadow-lg shadow-emerald-500/20 transition-all transform active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Invia Alert / Contatta
        </a>

        <a
          href="/cv.pdf"
          download="Michele_Dilollo_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-semibold font-mono text-sm transition-all"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Scarica CV Ufficiale (ATS)
        </a>

        <a
          href="#skills"
          class="inline-flex items-center gap-2 px-5 py-3 text-slate-400 hover:text-emerald-400 font-mono text-sm transition-colors"
        >
          <span>Esplora Competenze & Tools</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <!-- Enterprise Metrics Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 pt-6 border-t border-slate-800/80">
        {profile.stats.map((item) => (
          <div class="p-4 rounded-xl bg-slate-900/40 border border-slate-800/80 backdrop-blur-xs">
            <div class="text-2xl sm:text-3xl font-extrabold font-mono text-emerald-400 mb-1">
              {item.value}
            </div>
            <div class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-1">
              {item.label}
            </div>
            <div class="text-[11px] text-slate-400 leading-normal">
              {item.description}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
