---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SkillsMatrix from "../components/SkillsMatrix.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ResearchSpotlight from "../components/ResearchSpotlight.astro";
import Education from "../components/Education.astro";
import QuickTerminal from "../components/QuickTerminal.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Michele Dilollo | Cybersecurity Specialist, Incident Responder & DFIR Expert"
  description="Portfolio enterprise di Michele Dilollo: Incident Responder e Digital Forensics & Incident Response (DFIR) Specialist a Roma. Difesa di infrastrutture enterprise e governative, memory forensics con Volatility, reverse engineering malware, threat hunting e automazione."
>
  <Navbar />
  <main id="main-content">
    <Hero />
    <About />
    <SkillsMatrix />
    <ExperienceTimeline />
    <ResearchSpotlight />
    <Education />
    <QuickTerminal />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
